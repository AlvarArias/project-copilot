# Copy this file to `.env` and fill in the values before running the app.
# See /SETUP.md for the full local setup walkthrough.

# --- OpenAI (agent tool-calling via LLMProvider, and embeddings via ------
# --- EmbeddingsProvider: text-embedding-3-small -> vector(1536)) ---------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Anthropic (optional, not used by the MVP) ----------------------------
# The agent talks to LLMProvider, an interface with a single OpenAIProvider
# implementation for now. This key is kept here, commented out, as a
# placeholder for a future AnthropicProvider adapter (see PLAN.md, decision D5).
# ANTHROPIC_API_KEY=

# --- Postgres + pgvector ---------------------------------------------------
# Local dev: matches the `docker-compose.yml` Postgres service in this repo.
#   docker compose up -d
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_copilot
#
# Production: connection string from your Supabase project
# (Project Settings -> Database -> Connection string -> URI), after enabling
# the `vector` extension (Database -> Extensions -> vector).
#   DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_copilot
