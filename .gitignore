# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example is intentionally versioned, see /SETUP.md)
.env
.env.local
.env.*.local

# vercel
.vercel

# per-subagent working memory (local notes, not project source)
.claude/agent-memory/

# typescript
*.tsbuildinfo
next-env.d.ts

# Secrets and credentials — never commit
.env
.env.*
!.env.example
GoogleService-Info*.plist
*.p8
*.p12
*.pem
*.mobileprovision
.netrc

# Claude Code — personal/local settings
.claude/settings.local.json

# Xcode user data
xcuserdata/
*.xcuserstate
.DS_Store
